# PROD-2 / Step 5.8.1 · 私有 Staging 运行时环境变量（模板）
#
# 真实文件由 `deploy/app/setup-staging-env.sh` 生成到：
#
#     /etc/chaoge/staging.env      root:root     0600
#
# 0600 = 只有 root（systemd）可读写；运行时账号通过 systemd 注入的环境变量取值，
# 不需要、也不能直接读取该文件。
# **不要把真实文件提交进 Git**；这个模板里没有任何真实口令。
#
# ⚠️ 这里刻意**没有** HOSTNAME / PORT。
#    systemd 的 EnvironmentFile 会覆盖 unit 里的 Environment=，
#    如果配置文件能写 HOSTNAME，一行误写就能把服务绑到 0.0.0.0。
#    绑定地址写死在 systemd 单元的 ExecStart 里，配置文件无法改变它。

# ── 运行环境 ──────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── 数据源 ────────────────────────────────────────────────────────────────────
#
# 只有显式等于 postgres 才切库。生产/预发必须显式写这一行。

DATA_SOURCE=postgres

# 应用连接串：**必须是 chaoge_staging_app**，不是 chaoge_migrator（迁移角色不应参与
# 运行时），更不是 postgres；也**不得**复用生产的 chaoge_app。
# Step 5.8.2 起 staging 使用独立的 chaoge_staging 库，生产库 chaoge_prod 不受
# Mock 测试数据影响。口令里的特殊字符必须百分号编码——setup-staging-env.sh 会自动编码。
DATABASE_URL=postgresql://chaoge_staging_app:<URL-encoded-password>@127.0.0.1:5432/chaoge_staging

# 连接池上限。2 vCPU / 2GB 单机建议 5（setup-staging-env.sh 默认写入这一行）。
PG_POOL_MAX=5

# ── Mock 开关（私有 Staging 的刻意取舍）───────────────────────────────────────
#
# 现状：用户端、管理端、客服端**三套登录全部是 Mock 实现**（真正的微信登录尚未接入）。
# 如果把这些开关全关掉，staging 上**没有任何人能登录**——页面只剩登录引导，
# 业务验收无从做起。因此私有 Staging 默认开启它们。
#
# 为什么这仍然是安全的：
#   · 服务只监听 127.0.0.1:3000（systemd ExecStart 写死），公网不可达；
#   · 唯一的访问方式是 SSH 隧道，入口是服务器的 SSH 账号；
#   · 部署脚本在每次重启后都会用 `ss -ltn` **实测**监听地址，非回环直接判失败。
#
# 关闭条件：接入真实登录之后，删掉下面四行即可，无需改代码。

ENABLE_MOCK_AUTH=true
ENABLE_MOCK_ADMIN=true
ENABLE_MOCK_STAFF=true
ENABLE_MOCK_PAYMENT=true

# ⚠️ ENABLE_MOCK_DEBUG **刻意不设**（等同关闭）。
#
#    它除了开放 ?mockError / ?mockEmpty / ?mockDelay，还会开放
#    POST /api/debug/reset —— 一个能清空进程内 Mock 存储的破坏性接口。
#    私有 staging 上没有人需要它（那是自动化测试用的），
#    而「多一个能清数据的接口」没有任何收益。保持关闭。
