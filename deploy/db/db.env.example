# 生产凭据文件模板 —— 目标路径 /etc/chaoge/db.env（root:chaoge 0640）
#
# ⚠️ 这是**模板，不是要拷贝的文件**，里面没有任何真实凭据，可以安全进 Git。
#    真正的 /etc/chaoge/db.env 由 `deploy/db/setup-credentials.sh` 生成：
#    口令从终端读取，不进 shell 历史、不进 argv、不进环境变量、不留日志。
#
#    不要用 `cp db.env.example /etc/chaoge/db.env` 再手改——那样得到的文件权限
#    会是 0644（others 可读），而且不会有任何提示。用脚本，它会原子地把权限设对。

# 数据源开关。**只有显式等于字符串 postgres 时才切到数据库**。
# 留空或删除该行都等于继续用 Mock store —— 生产上若误删这一行，
# 应用不会报错，只会安静地退回内存 Mock 数据。
DATA_SOURCE=postgres

# 应用连接串。必须用 **chaoge_app**，不要用 chaoge_migrator：
# 迁移角色持有建表能力，而应用进程自始至终不该有 DDL 权限（见 README §2）。
#
# ⚠️ 下面这行是占位示例，不是真实凭据。真实值由 setup-credentials.sh 写入。
# ⚠️ 口令里的特殊字符会被百分号编码，不要手工拼这个串。
DATABASE_URL=postgresql://chaoge_app:REPLACE_ME@127.0.0.1:5432/chaoge_prod

# 连接池上限。不设时生产为 10。
# 只在确有必要时调整，并留意 README §6 关于连接数的说明。
# PG_POOL_MAX=10

# —————————————————————————————————————————————————————————————
# 以下变量**刻意不出现在这里**，在生产环境上设置它们是事故：
#
#   ENABLE_MOCK_AUTH / ENABLE_MOCK_PAYMENT / ENABLE_MOCK_ADMIN / ENABLE_MOCK_STAFF
#       会在生产上开放模拟登录接口，等于把后台入口敞开。
#
#   ENABLE_MOCK_DEBUG
#       会开放 POST /api/debug/reset —— 一个能清空数据源的接口。
#
#   TEST_DATABASE_URL
#       属于测试环境。生产进程不需要，也不该知道测试库的存在。
#
#   NODE_ENV
#       由服务单元（systemd）设置，不放在这个文件里——
#       它是 db:seed / db:reset 守卫的一部分，让凭据文件与运行模式脱钩更安全。
# —————————————————————————————————————————————————————————————
