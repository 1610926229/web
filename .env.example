# 环境变量示例 —— 只记录变量名与安全的开发取值，不包含任何密钥。
#
# 使用方式：复制为 .env.local（该文件已被 .gitignore 忽略），按需修改。
#     cp .env.example .env.local
#
# 这些开关都只在**显式等于字符串 true** 时才开启。留空、写成 false 或删除该行
# 都等同于关闭。正式部署不要设置这些变量。
#
# 这里不会有、也不允许出现任何真实凭据：没有 AppID、AppSecret、商户号、证书或 API Key。
# 本项目不接入真实微信支付，所有开关只影响本地模拟行为。

# 模拟登录开关。
# 开启：/api/auth/mock-login 与 /api/auth/logout 可用，mock_user_id Cookie 能产生登录身份，
#       登录拦截页显示「模拟微信登录」按钮。
# 关闭：上述接口一律返回 404，Cookie 不再产生任何登录身份，页面上不出现模拟登录控件。
ENABLE_MOCK_AUTH=true

# Mock 调试开关。
# 开启：?mockError=1 / ?mockEmpty=<范围> / ?mockDelay=<ms> 才会影响取数结果与延迟；
#       并开放 POST /api/debug/reset —— 把本进程的全部 Mock 存储清回预置（测试专用）。
# 关闭：这些查询参数被完全忽略，数据与延迟都不受影响；/api/debug/reset 返回 404。
#
# ⚠️ 开启时 /api/debug/reset 在**本进程内是破坏性的**（任何能访问该服务的人都能清空 Mock 数据）。
#    Mock 数据是一次性的内存数据、无真实用户数据，但**这个开关不能开在任何有真实数据的部署上**。
# ⚠️ 接真实后端时，`app/api/debug/reset/route.ts` 与 `lib/services/mockStores.ts` 要一起删除——
#    真实测试该用独立的测试库，而不是给线上服务开一个清库接口。
ENABLE_MOCK_DEBUG=true

# 模拟支付开关。
# 开启：/api/payments/mock-confirm 可用，支付结果页显示「模拟支付成功 / 失败 / 取消」三个按钮
#       （仅供本地开发验证三条支付路径，不代表真实微信支付页面）。
# 关闭：该接口返回 404，页面上不出现任何模拟支付控件，待支付的支付请求无法在本地完成。
ENABLE_MOCK_PAYMENT=true

# 模拟管理员登录开关（管理后台，与 ENABLE_MOCK_AUTH 相互独立）。
# 开启：/api/admin/auth/mock-login 可用，mock_admin_id Cookie 能产生管理者身份，
#       /admin/login 显示「模拟管理员登录」按钮。
# 关闭：该接口返回 404，/admin/login 不显示任何登录控件，伪造 mock_admin_id
#       也不会获得任何管理权限；此时 /admin 一律回到登录引导页。
# 注意：管理端 Cookie 与用户端 Cookie 是两个不同的 Cookie，互不产生对方身份。
ENABLE_MOCK_ADMIN=true

# 模拟客服端登录开关（客服工作台，与上面两个开关相互独立）。
# 开启：/api/staff/auth/mock-login 可用，mock_staff_id Cookie 能产生客服身份，
#       /staff/login 列出**启用中且未移除**的客服测试账号供选择。
# 关闭：该接口返回 404，/staff/login 不显示任何账号选择控件，伪造 mock_staff_id
#       也不会获得任何客服权限；此时 /staff 一律回到登录引导页。
# 注意：这是**第三个**独立 Cookie。用户端 Cookie 与管理端 Cookie 都进不了客服工作台，
#       客服 Cookie 也调不了用户接口与管理接口。
ENABLE_MOCK_STAFF=true

# —————————————————————————————————————————————————————————————
# PostgreSQL（PROD-1A 引入）
#
# ⚠️ 上面那组开关的规则是「显式等于字符串 true 才开启」；**下滑到此为止**，
#    下面的变量语义不同，逐条写在各自注释里。
#
# ⚠️ 默认**不设** DATA_SOURCE（即不写这一行）就是 Mock 数据源，与引入数据库之前
#    的行为完全一致。除竖切片外，绝大多数数据仍在 globalThis Mock store 里。
# —————————————————————————————————————————————————————————————

# 数据源开关。**只有显式等于字符串 postgres 时才切到数据库**；
# 留空、写成别的值或删除该行都等于用 Mock。
#
# ⚠️ 能打开的只有已经迁到 PostgreSQL 的仓储（PROD-1A 竖切片：收藏、反馈）。
#    未迁移的实体无论这个值是什么都继续走 Mock。
# ⚠️ **严禁**把它当成「整体切库」的开关：禁止某个跨域事务「一半写 PostgreSQL、
#    一半写 Mock store」。见 docs/02-tech-design/tech-stack.md §11.1。
DATA_SOURCE=

# 应用连接串（**必填，当且仅当上面开了 DATA_SOURCE=postgres**）。
# 缺失或只有空白时，任何真正要用数据库的调用**立刻抛错**（fail-fast），
# 而不是退化成「连不上但所有查询返回空列表」——空列表和「真的没数据」长得一样。
#
# ⚠️ 下面这个值只是**占位示例，不是真实凭据**，随意照抄即可。
# ⚠️ 真实连接串只写进 .env.local 或部署环境的密钥管理里，**不要提交**。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaoge_esports

# 测试库连接串。只被两处使用：`pnpm test:pg` 的入口，以及 `pnpm db:* --target=test`。
#
# ⚠️ 库名必须以 `_test` 结尾——这是**硬性要求**，不是命名建议。
#    `pnpm db:reset` 会清空整库，守卫在**碰数据库之前**就检查库名后缀，
#    名字不对直接拒绝执行。这样「测试库」就不会被误配成开发库或生产库。
# ⚠️ 与上面的 DATABASE_URL **必须是两个不同的库**，不要指向同一个。
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaoge_esports_test

# 连接池上限。不设时：生产 10，其余（开发/测试）4。
# 只接受正整数，其它值等同于不设。
PG_POOL_MAX=

# 迁移目录覆盖。不设时是仓库根的 `db/migrations`。
# 仅供测试构造临时迁移目录（`tests/pgFoundation.test.mjs` 用它验证 DDL 失败时整体回滚）。
# 正常开发**不要设置**它。
PG_MIGRATIONS_DIR=

# ⚠️ 破坏性操作的两道守卫，均**不可通过配置绕过**：
#
#   1. `NODE_ENV=production` 时，seed 与 reset 一律拒绝执行；
#   2. reset 还要求目标库名以 `_test` 结尾。
#
#    因此 `pnpm db:reset --target=app` 会被参数解析直接拒绝，
#    而 `NODE_ENV=production pnpm db:reset` 会在碰数据库之前抛错。
#    生产环境**不能**种数据、也**不能**清库，这是设计目标而不是限制。
